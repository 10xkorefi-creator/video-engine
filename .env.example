# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...          # LLMs, research (web), ElevenLabs TTS + Scribe STT
PIXABAY_API_KEY=                         # free: pixabay.com/api/docs (stock footage/photos)
PEXELS_API_KEY=                          # optional, free: pexels.com/api (more portrait clips, less repetition)
SUPABASE_URL=https://qmaphtslnvvifkzmbrvh.supabase.co
SUPABASE_SERVICE_KEY=                    # service_role key (Storage upload + reel_jobs table)
SERVICE_TOKEN=                           # long random string; n8n sends it as "Authorization: Bearer ..."

# --- optional (defaults shown) ----------------------------------------------
SUPABASE_BUCKET=reels
SUPABASE_TABLE=reel_jobs
LANGUAGE=english                         # english | hinglish
TTS_MODEL=elevenlabs/eleven-v3
TTS_VOICE=4yF24b9emqK8f4DBqL2Q           # ElevenLabs voice-library ID (Hinglish)
TTS_MODEL_EN=                            # optional: English-only model, defaults to TTS_MODEL
TTS_VOICE_EN=RpiHVNPKGBg7UmgmrKrN        # English voice: Aashish (Indian English)
STT_MODEL=elevenlabs/scribe-v2
SCRIPT_MODEL=anthropic/claude-sonnet-5.5
CHECK_MODEL=anthropic/claude-haiku-5.5   # fact check + caption transliteration
RESEARCH_MODEL=anthropic/claude-haiku-5.5
RESEARCH_RESULTS=6                       # web results per blog (~$0.004 each)
AI_VIDEO_MODEL=google/veo-3.1-lite       # AI B-roll (blank = stock footage only)
AI_VIDEO_RESOLUTION=720p                 # upscaled to 1080p; 1080p costs ~1.7x more
AI_VIDEO_BUDGET=1.3                      # hard cap per reel in USD; beats beyond it use stock
AI_VIDEO_PRICE_PER_SEC=0.03              # Veo 3.1 Lite, no audio: 0.03 at 720p, 0.05 at 1080p
MIN_SECONDS=40
MAX_SECONDS=60                           # normal reel
MAX_LONG_SECONDS=180                     # only when the story needs it (script sets length=long)
RENDER_WORKERS=4                         # parallel Chrome capture workers (≈ REEL_CPUS)
REEL_CPUS=4                              # CPU cores the container may use (leave the rest for n8n)
REEL_MEM=8g
RENDER_QUALITY=standard
PORT=8080
